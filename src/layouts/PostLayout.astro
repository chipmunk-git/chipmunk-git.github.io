---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import SampleNotice from '../components/SampleNotice.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostCard from '../components/PostCard.astro';
import { withBase } from '../lib/urls';
import { formatDate, readingMinutes } from '../lib/format';
import type { Post, Project } from '../lib/content';
interface Props { post: Post; headings: MarkdownHeading[]; project?: Project; previous?: Post; next?: Post; relatedPosts: Post[]; }
const { post, headings, project, previous, next, relatedPosts } = Astro.props;
const { data } = post;
---
<BaseLayout title={data.title} description={data.description} noindex={data.sample}>
  <div class="container">
    <header class="article-header">
      <a class="back-link" href={withBase('/blog/')}>← All notes</a>
      <p class="eyebrow">{data.category ?? 'Engineering Note'}</p>
      <h1>{data.title}</h1><p class="page-description">{data.description}</p>
      <div class="article-meta"><span>{data.sample ? '예시 날짜 · ' : ''}<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></span>{data.updated && <span>수정 <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></span>}<span>약 {readingMinutes(post.body)}분</span></div>
      {data.tags.length > 0 && <ul class="tags" aria-label="태그">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <div class="article-shell">
      <article class="article-main" aria-label={data.title}>
        {data.sample && <SampleNotice kind="post" />}
        {data.thumbnail && <figure class="article-image"><Image src={data.thumbnail} alt={data.thumbnailAlt!} width={960} loading="eager" /><figcaption>{data.thumbnailAlt}</figcaption></figure>}
        <div class="prose"><slot /></div>
        {project && <section class="related-section" aria-labelledby="project-title"><h2 id="project-title">Related Project</h2><a class="related-project" href={withBase(`/projects/${project.id}/`)}>{project.data.title} →<small>{project.data.sample ? 'Sample case study' : project.data.description}</small></a></section>}
        {relatedPosts.length > 0 && <section class="related-section" aria-labelledby="related-title"><h2 id="related-title">Related Posts</h2>{relatedPosts.map((related) => <PostCard post={related} compact />)}</section>}
        {(previous || next) && <nav class="post-navigation" aria-label="이전 다음 글"><div>{previous && <a href={withBase(`/blog/${previous.id}/`)} rel="prev"><small>← 이전 글</small>{previous.data.title}</a>}</div><div class="next">{next && <a href={withBase(`/blog/${next.id}/`)} rel="next"><small>다음 글 →</small>{next.data.title}</a>}</div></nav>}
      </article>
      <aside class="article-toc"><TableOfContents headings={headings} /></aside>
    </div>
  </div>
</BaseLayout>
