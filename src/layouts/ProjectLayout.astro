---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import SampleNotice from '../components/SampleNotice.astro';
import PostCard from '../components/PostCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Project, Post } from '../lib/content';
import { withBase } from '../lib/urls';
interface Props { project: Project; headings: MarkdownHeading[]; relatedPosts: Post[]; }
const { project, headings, relatedPosts } = Astro.props;
const { data } = project;
---
<BaseLayout title={data.title} description={data.description} noindex={data.sample}>
  <div class="container project-document">
    <article aria-labelledby="project-title">
      <header class="project-document-header">
        <a class="back-link" href={withBase('/projects/')}>← Projects</a>
        <p class="eyebrow">{data.category ?? 'Project'}</p>
        <h1 id="project-title">{data.title}</h1>
        <p class="page-description">{data.description}</p>
      </header>
      {data.sample && <SampleNotice />}
      <ProjectMeta project={project} />
      {headings.length > 0 && <details class="project-contents"><summary>프로젝트 목차</summary><TableOfContents headings={headings} /></details>}
      <div class="prose"><slot /></div>
      {relatedPosts.length > 0 && <section class="related-section" aria-labelledby="related-title"><h2 id="related-title">관련 개발 기록</h2>{relatedPosts.map((post) => <PostCard post={post} compact />)}</section>}
      {data.repository && <section class="related-section" aria-labelledby="repository-title"><h2 id="repository-title">소스 코드</h2><a class="text-link" href={data.repository}>GitHub에서 코드 보기 ↗</a></section>}
    </article>
  </div>
</BaseLayout>
