---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { withBase } from '../lib/urls';
const interestNotes: Record<string, string> = {
  'Embedded Systems': '하드웨어와 소프트웨어가 연결되는 시스템',
  Robotics: '센서, 제어, 통신을 함께 다루는 로봇 시스템',
  'Computer Vision': '이미지와 영상에서 정보를 얻는 과정',
  'Physical AI': '장기적으로 탐색하고 싶은 관심 분야',
};
---
<BaseLayout title="About" description="생명과학 전공 이후 임베디드와 로보틱스로 학습 방향을 넓히는 과정과 관심 분야.">
  <div class="container">
    <header class="page-header"><p class="eyebrow">Background &amp; Direction</p><h1>About</h1><p class="page-description">{site.hero.introduction}</p></header>
    <section class="about-section" aria-labelledby="background-title"><h2 id="background-title">Background</h2><div><p>현재 관심은 하드웨어와 소프트웨어가 연결되는 시스템에 있습니다. STM32, ROS2, Computer Vision을 공부하며 임베디드와 로보틱스로 학습 범위를 넓히고 있습니다.</p><p>이 사이트에는 프로젝트를 정리한 case study와 공부·실험 과정의 기록을 나누어 쌓으려 합니다. 확인한 사실과 원인 추정을 구분하고, 팀의 결과와 개인 기여를 별도로 기록합니다.</p></div></section>
    <section class="about-section" aria-labelledby="interests-title"><h2 id="interests-title">Interests</h2><ul class="interest-list">{site.interests.map((interest) => <li><h3>{interest}</h3><p>{interestNotes[interest]}</p></li>)}</ul></section>
    <!-- 사용자 요청으로 Currently Learning은 표시하지 않으며 site.learning 데이터는 보존합니다. -->
    <section class="about-section" aria-labelledby="links-title"><h2 id="links-title">Links</h2><div class="actions"><a class="text-link" href={withBase('/projects/')}>Projects →</a><a class="text-link" href={withBase('/blog/')}>Engineering Blog →</a>{site.githubUrl && <a class="text-link" href={site.githubUrl}>GitHub ↗</a>}{site.socialLinks.map((link) => <a class="text-link" href={link.url}>{link.label} ↗</a>)}</div></section>
  </div>
</BaseLayout>
