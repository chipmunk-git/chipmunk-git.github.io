---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedContent } from '../../lib/content';
const { projects } = await getPublishedContent();
---
<BaseLayout title="Projects" description="임베디드와 Computer Vision 프로젝트의 구조, 개인 기여, 기술 선택과 문제 해결을 정리하는 case study.">
  <div class="container project-gallery-page">
    <header class="page-header"><p class="eyebrow">Portfolio</p><h1>Projects</h1><p class="page-description">프로젝트별 시스템 구조, 참여 범위, 구현과 문제 해결 기록을 정리했습니다.</p></header>
    {projects.some((project) => project.data.sample) && <aside class="sample-notice"><strong>Sample / Placeholder</strong><p>현재 예시 프로젝트는 페이지 구성 검증용입니다. 실제 기간, 개인 기여, repository와 실행 결과는 확인 후 추가합니다.</p></aside>}
    <section aria-labelledby="gallery-title"><h2 id="gallery-title" class="sr-only">프로젝트 갤러리</h2>{projects.length > 0 ? <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div> : <p class="empty-state">프로젝트를 정리하고 있습니다.</p>}</section>
  </div>
</BaseLayout>
