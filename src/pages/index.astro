---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { profile } from '../config/profile';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import ProfileSections from '../components/ProfileSections.astro';
import { site } from '../config/site';
import { getPublishedContent } from '../lib/content';
import { withBase } from '../lib/urls';
const { projects, posts } = await getPublishedContent();
const featured = projects.filter((project) => project.data.featured).slice(0, 4);
---

<BaseLayout>
  <div class="container portfolio-home">
    <header class="portfolio-intro">
      <p class="eyebrow">Portfolio</p>
      <h1>{site.hero.heading}</h1>
      <div class="portfolio-intro-profile">
        <figure class="profile-portrait">
          {profile.photo ? (
            <Image src={profile.photo.src} alt={profile.photo.alt} width={144} loading="eager" />
          ) : (
            <div class="portrait-placeholder">
              <span>프로필 사진<br />준비 중</span>
            </div>
          )}
        </figure>
        <p class="portfolio-introduction">{site.hero.introduction}</p>
        <div class="actions">
          <a class="text-link" href="#projects">Projects ↓</a>
          {posts.length > 0 && <a class="text-link" href="#blog">Blog ↓</a>}
        </div>
      </div>
    </header>
    <ProfileSections />
    <section id="projects" class="portfolio-section portfolio-projects" aria-labelledby="featured-title">
      <div class="section-heading"><h2 id="featured-title">Projects</h2><a class="text-link" href={withBase('/projects/')} aria-label="프로젝트 전체 보기">전체 보기 →</a></div>
      {featured.some((project) => project.data.sample) && <p class="section-description">현재 Sample 카드는 구성을 확인하기 위한 예시입니다. 실제 기여와 결과는 자료 확인 후 작성합니다.</p>}
      {featured.length > 0 ? <div class="project-grid">{featured.map((project) => <ProjectCard project={project} />)}</div> : <p class="empty-state">대표 프로젝트를 정리하고 있습니다.</p>}
    </section>
    {posts.length > 0 ? (
      <section id="blog" class="portfolio-section" aria-labelledby="posts-title">
        <div class="section-heading"><h2 id="posts-title">Blog</h2><a class="text-link" href={withBase('/blog/')} aria-label="블로그 글 전체 보기">전체 보기 →</a></div>
        {posts.slice(0, 3).map((post) => <PostCard post={post} compact />)}
      </section>
    ) : <p class="portfolio-note">공부와 실험 과정은 <a href={withBase('/blog/')}>Blog</a>에 기록합니다. 현재 공개할 글을 정리하고 있습니다.</p>}
  </div>
</BaseLayout>
